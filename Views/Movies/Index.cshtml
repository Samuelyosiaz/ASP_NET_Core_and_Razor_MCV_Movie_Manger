@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "My movies";
}

<div class="movies-header">
    <div>
        <h1>My movies</h1>
        <p class="text-muted mb-0">Browse and filter your movie collection.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<form asp-controller="Movies" asp-action="Index" method="get" class="movie-filters">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-4">
            <label asp-for="MovieGenre" class="form-label">Genre</label>
            <select asp-for="MovieGenre" asp-items="Model.Genres" class="form-select">
                <option value="">All genres</option>
            </select>
        </div>
        <div class="col-12 col-md-3">
            <label asp-for="Year" class="form-label">Year</label>
            <select asp-for="Year" asp-items="Model.Years" class="form-select">
                <option value="">All years</option>
            </select>
        </div>
        <div class="col-12 col-md-5">
            <label asp-for="SearchString" class="form-label">Title</label>
            <div class="input-group">
                <input asp-for="SearchString" class="form-control" placeholder="Search by title" />
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </div>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle movie-table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Movies![0].Title)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Movies![0].Genre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Movies![0].Price)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Movies![0].Rating)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Movies!)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ReleaseDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Genre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Price)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Rating)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>